<aside
    class="client-assistant"
    data-client-assistant
    data-client-id="{{ app.user.id }}"
    data-endpoint="{{ path('app_client_assistant_message') }}"
    data-draft-endpoint="{{ path('app_client_assistant_ticket_draft') }}"
    data-csrf-token="{{ csrf_token('client-assistant-message') }}"
    data-ticket-id="{{ app.request.attributes.get('_route') == 'app_client_ticket_show' ? app.request.attributes.get('id') : '' }}"
>
    <section class="client-assistant__welcome-card" data-assistant-welcome-card aria-label="Message de bienvenue de l’assistant">
        <div class="client-assistant__welcome-content">
            <img
                class="client-assistant__welcome-image"
                src="/images/assistant/pilot-ai-assistant.png"
                alt="Robot assistant Pilot AI"
            >
            <p>
                <strong>Vous avez besoin d'aide ?</strong>
                <span>Vous pouvez poser votre question à votre nouvel assistant virtuel !</span>
            </p>
        </div>
        <button class="client-assistant__welcome-close" type="button" data-assistant-welcome-close>
            Fermer le message
        </button>
    </section>

    <section id="client-assistant-panel" class="client-assistant__panel" data-assistant-panel hidden aria-label="Assistant support">
        <header class="client-assistant__header">
            <span class="client-assistant__identity" aria-hidden="true">AI</span>
            <span>
                <strong>Pilot AI</strong>
                <small>Assistant support</small>
            </span>
            <button class="client-assistant__close" type="button" data-assistant-close aria-label="Fermer l’assistant">×</button>
        </header>

        <div class="client-assistant__messages" data-assistant-messages role="log" aria-live="polite" aria-relevant="additions">
            <article class="client-assistant__message client-assistant__message--bot">
                <strong>Pilot AI</strong>
                <p>Bonjour ! Comment puis-je vous aider ?</p>
            </article>
        </div>

        <form class="client-assistant__form" data-assistant-form>
            <label class="client-assistant__sr-only" for="client-assistant-input">Votre message</label>
            <textarea id="client-assistant-input" name="message" maxlength="2000" placeholder="Écrivez votre question..." required></textarea>
            <button type="submit" data-assistant-submit>Envoyer</button>
        </form>
    </section>

    <button
        class="client-assistant__toggle"
        type="button"
        data-assistant-toggle
        aria-expanded="false"
        aria-controls="client-assistant-panel"
        aria-label="Ouvrir l’assistant Pilot AI"
    >
        <span aria-hidden="true">✦</span>
    </button>
</aside>

<style>
    .client-assistant {
        --assistant-primary: #5b5bd6;
        --assistant-ink: #172033;
        --assistant-muted: #64748b;
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        z-index: 100;
        color: var(--assistant-ink);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .client-assistant__toggle {
        display: grid;
        width: 3.75rem;
        height: 3.75rem;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--assistant-primary), #7474eb);
        color: #fff;
        box-shadow: 0 12px 32px rgba(55, 55, 140, 0.32);
        font-size: 1.6rem;
        cursor: pointer;
    }

    .client-assistant__welcome-card {
        position: absolute;
        right: 0;
        bottom: 4.9rem;
        width: min(26rem, calc(100vw - 2rem));
        padding: 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 18px 44px rgba(23, 32, 51, 0.16);
    }

    .client-assistant__welcome-card[hidden] {
        display: none;
    }

    .client-assistant__welcome-card::after {
        position: absolute;
        right: 1.35rem;
        bottom: -0.55rem;
        width: 1.1rem;
        height: 1.1rem;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
        content: "";
        transform: rotate(45deg);
    }

    .client-assistant__welcome-content {
        display: flex;
        gap: 1.15rem;
        align-items: center;
    }

    .client-assistant__welcome-image {
        width: 6.25rem;
        height: auto;
        flex: 0 0 6.25rem;
        object-fit: contain;
    }

    .client-assistant__welcome-card p {
        margin: 0;
        color: var(--assistant-ink);
        font-size: 0.95rem;
        line-height: 1.45;
    }

    .client-assistant__welcome-card strong,
    .client-assistant__welcome-card span {
        display: block;
    }

    .client-assistant__welcome-card span {
        margin-top: 0.2rem;
        color: var(--assistant-muted);
    }

    .client-assistant__welcome-close {
        display: inline-flex;
        width: fit-content;
        margin: 0.9rem 0 0 auto;
        padding: 0.6rem 0.85rem;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 0.7rem;
        background: #eef2ff;
        color: var(--assistant-primary);
        font-weight: 800;
        cursor: pointer;
    }

    .client-assistant__panel {
        display: flex;
        width: min(25rem, calc(100vw - 2rem));
        height: min(34rem, calc(100dvh - 7rem));
        min-height: 20rem;
        flex-direction: column;
        margin-bottom: 0.85rem;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 22px 60px rgba(23, 32, 51, 0.2);
    }

    .client-assistant__panel[hidden] {
        display: none;
    }

    .client-assistant__header {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        padding: 1rem;
        background: linear-gradient(135deg, #f1f0ff, #f7fbff);
    }

    .client-assistant__identity {
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        border-radius: 0.8rem;
        background: var(--assistant-primary);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 900;
    }

    .client-assistant__header strong,
    .client-assistant__header small {
        display: block;
    }

    .client-assistant__header small {
        margin-top: 0.15rem;
        color: var(--assistant-muted);
        font-size: 0.75rem;
    }

    .client-assistant__close {
        margin-left: auto;
        border: 0;
        background: transparent;
        color: var(--assistant-muted);
        font-size: 1.5rem;
        cursor: pointer;
    }

    .client-assistant__messages {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1rem;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .client-assistant__message {
        max-width: 90%;
        padding: 0.75rem 0.85rem;
        border-radius: 0.85rem;
        overflow-wrap: anywhere;
        font-size: 0.875rem;
        line-height: 1.5;
        white-space: pre-wrap;
    }

    .client-assistant__message p {
        margin: 0.3rem 0 0;
    }

    .client-assistant__message--bot {
        align-self: flex-start;
        background: #f1f5f9;
    }

    .client-assistant__message--client {
        align-self: flex-end;
        background: #eeeeff;
    }

    .client-assistant__message--error {
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #991b1b;
    }

    .client-assistant__draft-action {
        display: inline-flex;
        width: fit-content;
        margin-top: 0.65rem;
        padding: 0.55rem 0.75rem;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 0.65rem;
        background: var(--assistant-primary);
        color: #fff;
        font-weight: 800;
        cursor: pointer;
    }

    .client-assistant__draft-action:disabled {
        cursor: wait;
        opacity: 0.65;
    }

    .client-assistant__form {
        display: flex;
        gap: 0.5rem;
        align-items: end;
        padding: 0.75rem;
        border-top: 1px solid #e2e8f0;
    }

    .client-assistant__form textarea {
        min-width: 0;
        min-height: 2.75rem;
        max-height: 7rem;
        flex: 1;
        resize: vertical;
        padding: 0.65rem;
        border: 1px solid #cbd5e1;
        border-radius: 0.65rem;
        font-size: 0.875rem;
    }

    .client-assistant__form button {
        min-height: 2.75rem;
        padding: 0.6rem 0.8rem;
        border: 0;
        border-radius: 0.65rem;
        background: var(--assistant-primary);
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

    .client-assistant__form button:disabled {
        cursor: wait;
        opacity: 0.65;
    }

    .client-assistant__sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        clip-path: inset(50%);
    }

    @media (max-width: 36rem) {
        .client-assistant {
            right: 1rem;
            bottom: 1rem;
        }

        .client-assistant__panel {
            position: fixed;
            right: 1rem;
            bottom: 5.75rem;
            width: calc(100vw - 2rem);
            height: min(34rem, calc(100dvh - 7rem));
        }

        .client-assistant__welcome-card {
            position: fixed;
            right: 1rem;
            bottom: 5.75rem;
            width: calc(100vw - 2rem);
        }

        .client-assistant__welcome-content {
            align-items: flex-start;
        }

        .client-assistant__welcome-image {
            width: 5.25rem;
            flex-basis: 5.25rem;
        }
    }
</style>

<script src="/js/client-assistant.js" defer></script>
