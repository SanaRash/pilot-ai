{% extends 'base.html.twig' %}

{% block title %}{{ ticket.title }} | Pilot AI{% endblock %}

{% block body %}
    <style>
        .technician-ticket-detail {
            min-height: 100vh;
            padding: 3.5rem 2rem;
            background: #f4f7fb;
            color: #0f172a;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .technician-ticket-detail__content {
            width: min(100%, 80rem);
            margin: 0 auto;
        }

        .technician-ticket-detail__nav {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-bottom: 2rem;
        }

        .technician-ticket-detail__nav a,
        .technician-ticket-detail__button {
            display: inline-block;
            padding: 0.65rem 0.9rem;
            border: 1px solid #5b5bd6;
            border-radius: 0.7rem;
            background: linear-gradient(135deg, #5b5bd6, #6f6fe5);
            color: #fff;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
        }

        .technician-ticket-detail__button--secondary {
            border-color: #cbd5e1;
            background: #fff;
            color: #0f172a;
        }

        .technician-ticket-detail__back {
            display: inline-flex;
            gap: 0.45rem;
            align-items: center;
            width: fit-content;
            margin-bottom: 1rem;
            color: #5b5bd6;
            font-size: 0.82rem;
            font-weight: 750;
            text-decoration: none;
        }

        .technician-ticket-detail__back:hover,
        .technician-ticket-detail__back:focus-visible {
            color: #4747b8;
            text-decoration: underline;
        }

        .technician-ticket-detail__header {
            display: grid;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .technician-ticket-detail__reference {
            color: #5b5bd6;
            font-size: 0.8125rem;
            font-weight: 700;
        }

        .technician-ticket-detail h1 {
            margin: 0;
            font-size: 2rem;
            line-height: 1.2;
        }

        .technician-ticket-detail h2 {
            margin: 0 0 1rem;
            font-size: 1.25rem;
        }

        .technician-ticket-detail h3,
        .technician-ticket-detail h4 {
            margin: 0 0 0.75rem;
        }

        .technician-ticket-detail__grid {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(20rem, 0.8fr);
            gap: 1.25rem;
            align-items: start;
        }

        .technician-ticket-detail__stack {
            display: grid;
            gap: 1.25rem;
        }

        .technician-ticket-detail__card {
            min-width: 0;
            padding: 1.5rem;
            border: 1px solid #e6eaf0;
            border-radius: 1rem;
            background: #fff;
            box-shadow: 0 10px 28px rgba(23, 32, 51, 0.05);
        }

        .technician-ticket-detail__description {
            margin: 0 0 1.25rem;
            overflow-wrap: anywhere;
            color: #334155;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        .technician-ticket-detail__meta {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            margin: 0;
        }

        .technician-ticket-detail__meta dt {
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .technician-ticket-detail__meta dd {
            margin: 0.25rem 0 0;
            color: #0f172a;
            font-size: 0.9375rem;
        }

        .technician-ticket-detail__badges {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .technician-ticket-detail__badge {
            display: inline-flex;
            align-items: center;
            padding: 0.375rem 0.625rem;
            border-radius: 999px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .technician-ticket-detail__badge--priority {
            background: #fef3c7;
            color: #b45309;
        }

        .technician-ticket-detail__form {
            display: grid;
            gap: 0.75rem;
            margin: 0 0 1rem;
        }

        .technician-ticket-detail__form:last-child {
            margin-bottom: 0;
        }

        .technician-ticket-detail__form label {
            color: #334155;
            font-size: 0.8125rem;
            font-weight: 700;
        }

        .technician-ticket-detail__form select,
        .technician-ticket-detail__form textarea,
        .technician-ticket-detail__form input {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border: 1px solid #cbd5e1;
            border-radius: 0.5rem;
            font: inherit;
        }

        .technician-ticket-detail__list,
        .technician-ticket-detail__timeline {
            display: grid;
            gap: 1rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .technician-ticket-detail__item {
            min-width: 0;
            overflow-wrap: anywhere;
            padding: 1rem;
            border: 1px solid #e6eaf0;
            border-radius: 0.85rem;
            background: #f8fafc;
            transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
        }

        .technician-ticket-detail__item:hover {
            border-color: #d5d8f4;
            box-shadow: 0 8px 20px rgba(23, 32, 51, 0.05);
            transform: translateY(-1px);
        }

        .technician-ticket-detail__item a {
            color: #4f46c8;
            font-weight: 800;
            text-decoration: none;
        }

        .technician-ticket-detail__item a:hover,
        .technician-ticket-detail__item a:focus-visible {
            text-decoration: underline;
        }

        .technician-ticket-detail__item p {
            margin: 0.5rem 0 0;
            color: #475569;
        }

        .technician-ticket-detail__empty {
            margin: 0;
            padding: 1rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            background: #f8fafc;
            color: #64748b;
        }

        .technician-ticket-detail__ai-card {
            position: relative;
            overflow: hidden;
            border-color: #dcdcff;
            background:
                radial-gradient(circle at 100% 0, rgba(32, 184, 166, 0.12), transparent 28%),
                linear-gradient(180deg, #ffffff 0%, #fbfbff 100%);
        }

        .technician-ticket-detail__ai-card::before {
            position: absolute;
            inset: 0 0 auto;
            height: 4px;
            background: linear-gradient(90deg, #5b5bd6, #20b8a6);
            content: "";
        }

        .technician-ticket-detail__ai-heading {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .technician-ticket-detail__ai-title {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .technician-ticket-detail__ai-icon {
            display: grid;
            width: 2.75rem;
            height: 2.75rem;
            flex: none;
            place-items: center;
            border-radius: 0.85rem;
            background: linear-gradient(135deg, #5b5bd6, #20b8a6);
            color: #fff;
            box-shadow: 0 10px 24px rgba(91, 91, 214, 0.22);
            font-size: 0.82rem;
            font-weight: 900;
            letter-spacing: 0.03em;
        }

        .technician-ticket-detail__ai-title h2 {
            margin: 0;
        }

        .technician-ticket-detail__ai-kicker {
            margin: 0.2rem 0 0;
            color: #64748b;
            font-size: 0.78rem;
        }

        .technician-ticket-detail__ai-notice {
            margin: 0 0 1.25rem;
            padding: 0.8rem 1rem;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            background: rgba(255, 255, 255, 0.72);
            color: #596579;
            font-size: 0.82rem;
            line-height: 1.5;
        }

        .technician-ticket-detail__ai-card .empty-state {
            border-style: dashed;
            border-color: #d8daf5;
            background: rgba(247, 247, 255, 0.8);
            color: #636b7d;
        }

        .technician-ticket-detail__analysis {
            position: relative;
            overflow: hidden;
            padding: 1.25rem;
            border: 1px solid #e1e4f2;
            border-radius: 1rem;
            background: #fff;
            box-shadow: 0 8px 22px rgba(23, 32, 51, 0.04);
        }

        .technician-ticket-detail__analysis + .technician-ticket-detail__analysis {
            margin-top: 1rem;
        }

        .technician-ticket-detail__analysis-header {
            display: flex;
            gap: 1rem;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .technician-ticket-detail__analysis-header h3 {
            margin: 0;
            font-size: 1rem;
        }

        .technician-ticket-detail__analysis-date {
            color: #7b8494;
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .technician-ticket-detail__ai-summary {
            margin-bottom: 1rem;
            padding: 1rem;
            border-left: 3px solid #5b5bd6;
            border-radius: 0.55rem;
            background: #f7f7ff;
        }

        .technician-ticket-detail__ai-summary strong {
            display: block;
            margin-bottom: 0.35rem;
            color: #33346f;
            font-size: 0.75rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .technician-ticket-detail__ai-summary p {
            margin: 0;
            color: #293044;
            line-height: 1.6;
        }

        .technician-ticket-detail__ai-suggestions {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .technician-ticket-detail__ai-suggestion {
            padding: 0.85rem;
            border: 1px solid #e7e9f1;
            border-radius: 0.75rem;
            background: #fafbfc;
        }

        .technician-ticket-detail__ai-suggestion span {
            display: block;
            margin-bottom: 0.25rem;
            color: #7b8494;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .technician-ticket-detail__ai-suggestion strong {
            color: #20283a;
            font-size: 0.9rem;
        }

        .technician-ticket-detail__keywords {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
            margin: 0 0 1rem;
            padding: 0;
            list-style: none;
        }

        .technician-ticket-detail__keyword {
            padding: 0.35rem 0.6rem;
            border-radius: 999px;
            background: #eef8f6;
            color: #137d70;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .technician-ticket-detail__recommendations {
            margin: 0;
            padding-left: 1.15rem;
            color: #40495a;
        }

        .technician-ticket-detail__recommendations li + li {
            margin-top: 0.45rem;
        }

        .technician-ticket-detail__card > h3 {
            margin-top: 1.4rem;
            padding-top: 1.2rem;
            border-top: 1px solid #edf0f4;
            font-size: 1rem;
        }

        .technician-ticket-detail__timeline .technician-ticket-detail__item {
            position: relative;
            padding-left: 1.2rem;
        }

        .technician-ticket-detail__timeline .technician-ticket-detail__item::before {
            position: absolute;
            top: 1.1rem;
            left: -0.38rem;
            width: 0.7rem;
            height: 0.7rem;
            border: 2px solid #fff;
            border-radius: 999px;
            background: #5b5bd6;
            box-shadow: 0 0 0 1px #d9ddf2;
            content: "";
        }

        .technician-ticket-detail__actions-card {
            position: sticky;
            top: 6.25rem;
        }

        .technician-ticket-detail__actions-intro {
            margin: -0.35rem 0 1rem;
            color: #64748b;
            font-size: 0.8rem;
            line-height: 1.45;
        }

        .technician-ticket-detail__form + .technician-ticket-detail__form {
            padding-top: 1rem;
            border-top: 1px solid #edf0f4;
        }

        .technician-ticket-detail__form select,
        .technician-ticket-detail__form textarea,
        .technician-ticket-detail__form input {
            min-height: 2.8rem;
            border-color: #d9dee8;
            background: #fbfcfe;
        }

        .technician-ticket-detail__form select:focus-visible,
        .technician-ticket-detail__form textarea:focus-visible,
        .technician-ticket-detail__form input:focus-visible {
            border-color: #5b5bd6;
            outline: 3px solid #eeeeff;
        }

        @media (max-width: 60rem) {
            .technician-ticket-detail {
                padding: 1.5rem;
            }

            .technician-ticket-detail__grid,
            .technician-ticket-detail__meta,
            .technician-ticket-detail__ai-suggestions {
                grid-template-columns: 1fr;
            }

            .technician-ticket-detail__actions-card {
                position: static;
            }

            .technician-ticket-detail__analysis-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .technician-ticket-detail__nav a,
            .technician-ticket-detail__button {
                width: 100%;
                text-align: center;
            }
        }
    </style>

    <main class="technician-ticket-detail">
        <div class="technician-ticket-detail__content">
            <a class="technician-ticket-detail__back" href="{{ path('app_technician_tickets') }}">← Retour aux tickets ouverts</a>

            <header class="technician-ticket-detail__header">
                <div class="technician-ticket-detail__reference">#{{ ticket.id }}</div>
                <h1>{{ ticket.title }}</h1>
                <div class="technician-ticket-detail__badges">
                    <span class="technician-ticket-detail__badge">{{ status_labels[ticket.status] }}</span>
                    <span class="technician-ticket-detail__badge technician-ticket-detail__badge--priority">{{ priority_labels[ticket.priority] }}</span>
                </div>
            </header>

            <div class="technician-ticket-detail__grid">
                <div class="technician-ticket-detail__stack">
                    <section class="technician-ticket-detail__card" aria-labelledby="ticket-info-title">
                        <h2 id="ticket-info-title">Informations du ticket</h2>
                        <p class="technician-ticket-detail__description">{{ ticket.description }}</p>

                        <dl class="technician-ticket-detail__meta">
                            <div>
                                <dt>Client</dt>
                                <dd>{{ ticket.createdBy.firstname }} {{ ticket.createdBy.lastname }}</dd>
                            </div>
                            <div>
                                <dt>Statut</dt>
                                <dd>{{ status_labels[ticket.status] }}</dd>
                            </div>
                            <div>
                                <dt>Priorité</dt>
                                <dd>{{ priority_labels[ticket.priority] }}</dd>
                            </div>
                            <div>
                                <dt>Catégorie</dt>
                                <dd>{{ ticket.category ? ticket.category.name : 'Non catégorisé' }}</dd>
                            </div>
                            <div>
                                <dt>Assignation</dt>
                                <dd>
                                    {% if ticket.assignedTo %}
                                        {{ ticket.assignedTo.firstname }} {{ ticket.assignedTo.lastname }}
                                    {% else %}
                                        Non assigné
                                    {% endif %}
                                </dd>
                            </div>
                            <div>
                                <dt>Date de création</dt>
                                <dd>{{ ticket.createdAt|date('d/m/Y H:i') }}</dd>
                            </div>
                        </dl>
                    </section>

                    <section class="technician-ticket-detail__card technician-ticket-detail__ai-card" aria-labelledby="ai-title">
                        <div class="technician-ticket-detail__ai-heading">
                            <div class="technician-ticket-detail__ai-title">
                                <span class="technician-ticket-detail__ai-icon">AI</span>
                                <div>
                                    <h2 id="ai-title">Analyse Pilot AI</h2>
                                    <p class="technician-ticket-detail__ai-kicker">Aide à la qualification et à la résolution du ticket</p>
                                </div>
                            </div>
                        </div>

                        <p class="technician-ticket-detail__ai-notice">
                            Les résultats ci-dessous sont des recommandations générées par l’IA. Le technicien garde la décision finale sur la priorité, la catégorie et les actions à mener.
                        </p>

                        {% if ai_analyses is empty %}
                            {% include '_empty_state.html.twig' with {
                                message: 'Aucune analyse IA disponible pour ce ticket.'
                            } only %}
                        {% else %}
                            {% for analysis in ai_analyses %}
                                <article class="technician-ticket-detail__analysis">
                                    <div class="technician-ticket-detail__analysis-header">
                                        <h3>Diagnostic proposé</h3>
                                        <span class="technician-ticket-detail__analysis-date">{{ analysis.createdAt|date('d/m/Y H:i') }}</span>
                                    </div>

                                    <div class="technician-ticket-detail__ai-summary">
                                        <strong>Résumé automatique</strong>
                                        <p>{{ analysis.summary ?? 'Aucun résumé disponible.' }}</p>
                                    </div>

                                    <div class="technician-ticket-detail__ai-suggestions">
                                        <div class="technician-ticket-detail__ai-suggestion">
                                            <span>Priorité suggérée</span>
                                            <strong>
                                                {% if analysis.suggestedPriority %}
                                                    {{ priority_labels[analysis.suggestedPriority] ?? analysis.suggestedPriority }}
                                                {% else %}
                                                    Non déterminée
                                                {% endif %}
                                            </strong>
                                        </div>

                                        <div class="technician-ticket-detail__ai-suggestion">
                                            <span>Catégorie suggérée</span>
                                            <strong>{{ analysis.suggestedCategory ?? 'Non déterminée' }}</strong>
                                        </div>
                                    </div>

                                    <h4>Mots-clés détectés</h4>
                                    {% if analysis.keywords is empty %}
                                        <p>—</p>
                                    {% else %}
                                        <ul class="technician-ticket-detail__keywords">
                                            {% for keyword in analysis.keywords %}
                                                <li class="technician-ticket-detail__keyword">{{ keyword }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}

                                    <h4>Suggestions de résolution</h4>
                                    {% if analysis.suggestions is empty %}
                                        <p>—</p>
                                    {% else %}
                                        <ul class="technician-ticket-detail__recommendations">
                                            {% for suggestion in analysis.suggestions %}
                                                <li>{{ suggestion }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </article>
                            {% endfor %}
                        {% endif %}
                    </section>

                    <section class="technician-ticket-detail__card" aria-labelledby="similar-title">
                        <h2 id="similar-title">Tickets similaires</h2>

                        {% if similar_tickets is empty %}
                            {% include '_empty_state.html.twig' with {
                                message: 'Aucun ticket similaire trouvé.'
                            } only %}
                        {% else %}
                            <ul class="technician-ticket-detail__list">
                                {% for similar_ticket in similar_tickets %}
                                    <li class="technician-ticket-detail__item">
                                        <a href="{{ path('app_technician_ticket_show', {id: similar_ticket.id}) }}">
                                            #{{ similar_ticket.id }} — {{ similar_ticket.title }}
                                        </a>
                                        <p>
                                            {{ status_labels[similar_ticket.status] }}
                                            — {{ priority_labels[similar_ticket.priority] }}
                                            — {{ similar_ticket.category ? similar_ticket.category.name : 'Non catégorisé' }}
                                            — {{ similar_ticket.createdAt|date('d/m/Y H:i') }}
                                        </p>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </section>

                    <section class="technician-ticket-detail__card" aria-labelledby="interventions-title">
                        <h2 id="interventions-title">Interventions</h2>

                        {% if interventions is empty %}
                            {% include '_empty_state.html.twig' with {
                                message: 'Aucune intervention pour ce ticket.'
                            } only %}
                        {% else %}
                            <ol class="technician-ticket-detail__timeline">
                                {% for intervention in interventions %}
                                    <li class="technician-ticket-detail__item">
                                        <p>{{ intervention.content }}</p>
                                        <p>
                                            Par {{ intervention.technician.firstname }} {{ intervention.technician.lastname }}
                                            le {{ intervention.createdAt|date('d/m/Y H:i') }}
                                        </p>
                                        <p>{{ intervention.isClientVisible ? 'Visible au client' : 'Interne' }}</p>
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}

                        {% if can_add_intervention %}
                            <h3>Ajouter une intervention</h3>
                            {{ form_start(intervention_form, {attr: {class: 'technician-ticket-detail__form'}}) }}
                                {{ form_errors(intervention_form) }}
                                {{ form_row(intervention_form.content, {label: 'Contenu'}) }}
                                {{ form_row(intervention_form.isClientVisible) }}
                                <button class="technician-ticket-detail__button" type="submit">Ajouter l'intervention</button>
                            {{ form_end(intervention_form) }}
                        {% endif %}
                    </section>

                    <section class="technician-ticket-detail__card" aria-labelledby="history-title">
                        <h2 id="history-title">Historique</h2>

                        {% if ticket_history is empty %}
                            {% include '_empty_state.html.twig' with {
                                message: 'Aucun historique pour ce ticket.'
                            } only %}
                        {% else %}
                            <ol class="technician-ticket-detail__timeline">
                                {% for history in ticket_history %}
                                    <li class="technician-ticket-detail__item">
                                        <strong>{{ history_action_labels[history.action] ?? history.action }}</strong>
                                        <p>
                                            Ancienne valeur :
                                            {% if history.action == 'TICKET_ASSIGNED' %}
                                                {{ history.oldValue is null ? 'Non assigné' : 'Technicien #' ~ history.oldValue }}
                                            {% elseif history.action == 'CATEGORY_CHANGED' %}
                                                {{ history.oldValue is null ? 'Non catégorisé' : 'Catégorie #' ~ history.oldValue }}
                                            {% else %}
                                                {{ history.oldValue ?? '—' }}
                                            {% endif %}
                                        </p>
                                        <p>
                                            Nouvelle valeur :
                                            {% if history.action == 'TICKET_ASSIGNED' and history.newValue is not null %}
                                                Technicien #{{ history.newValue }}
                                            {% elseif history.action == 'CATEGORY_CHANGED' and history.newValue is not null %}
                                                Catégorie #{{ history.newValue }}
                                            {% else %}
                                                {{ history.newValue ?? '—' }}
                                            {% endif %}
                                        </p>
                                        <p>
                                            Auteur :
                                            {% if history.changedBy %}
                                                {{ history.changedBy.firstname }} {{ history.changedBy.lastname }}
                                            {% else %}
                                                Système
                                            {% endif %}
                                            — {{ history.createdAt|date('d/m/Y H:i') }}
                                        </p>
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}
                    </section>
                </div>

                <aside class="technician-ticket-detail__stack" aria-label="Actions du ticket">
                    <section class="technician-ticket-detail__card technician-ticket-detail__actions-card">
                        <h2>Actions du ticket</h2>
                        <p class="technician-ticket-detail__actions-intro">Mettez à jour uniquement les éléments nécessaires au traitement de cette demande.</p>

                        {% if not ticket.assignedTo %}
                            <form class="technician-ticket-detail__form" method="post" action="{{ path('app_technician_ticket_assign', {id: ticket.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('assign-ticket-' ~ ticket.id) }}">
                                <button class="technician-ticket-detail__button" type="submit">M'assigner ce ticket</button>
                            </form>
                        {% endif %}

                        {% if can_update_status %}
                            <form class="technician-ticket-detail__form" method="post" action="{{ path('app_technician_ticket_status', {id: ticket.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('update-ticket-status-' ~ ticket.id) }}">

                                <label for="ticket-status">Statut</label>
                                <select id="ticket-status" name="status">
                                    {% for status in allowed_statuses %}
                                        <option value="{{ status }}"{% if ticket.status == status %} selected{% endif %}>{{ status_labels[status] }}</option>
                                    {% endfor %}
                                </select>

                                <button class="technician-ticket-detail__button" type="submit">Modifier le statut</button>
                            </form>
                        {% endif %}

                        {% if can_update_priority %}
                            <form class="technician-ticket-detail__form" method="post" action="{{ path('app_technician_ticket_priority', {id: ticket.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('update-ticket-priority-' ~ ticket.id) }}">

                                <label for="ticket-priority">Priorité</label>
                                <select id="ticket-priority" name="priority">
                                    {% for priority in allowed_priorities %}
                                        <option value="{{ priority }}"{% if ticket.priority == priority %} selected{% endif %}>{{ priority_labels[priority] }}</option>
                                    {% endfor %}
                                </select>

                                <button class="technician-ticket-detail__button" type="submit">Modifier la priorité</button>
                            </form>
                        {% endif %}

                        {% if can_update_category %}
                            {% if categories is not empty %}
                                <form class="technician-ticket-detail__form" method="post" action="{{ path('app_technician_ticket_category', {id: ticket.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('update-ticket-category-' ~ ticket.id) }}">

                                    <label for="ticket-category">Catégorie</label>
                                    <select id="ticket-category" name="category_id">
                                        {% for category in categories %}
                                            <option value="{{ category.id }}"{% if ticket.category and ticket.category.id == category.id %} selected{% endif %}>{{ category.name }}</option>
                                        {% endfor %}
                                    </select>

                                    <button class="technician-ticket-detail__button" type="submit">Modifier la catégorie</button>
                                </form>
                            {% else %}
                                {% include '_empty_state.html.twig' with {
                                message: "Aucune catégorie n'est disponible."
                            } only %}
                            {% endif %}
                        {% endif %}

                        {% if ticket.assignedTo and not can_update_status and not can_update_priority and not can_update_category and not can_add_intervention %}
                            {% include '_empty_state.html.twig' with {
                                message: 'Aucune action disponible pour ce ticket.'
                            } only %}
                        {% endif %}
                    </section>
                </aside>
            </div>
        </div>
    </main>
{% endblock %}
