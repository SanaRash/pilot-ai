{% extends 'base.html.twig' %}

{% block title %}{{ ticket.title }} | Pilot AI{% endblock %}

{% block body %}

    <h1>{{ ticket.title }}</h1>

    {% for message in app.flashes('success') %}
        <div>
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div>
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('info') %}
        <div>
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div>
            {{ message }}
        </div>
    {% endfor %}

    <dl>
        <dt>Description</dt>
        <dd>{{ ticket.description }}</dd>

        <dt>Client</dt>
        <dd>{{ ticket.createdBy.firstname }} {{ ticket.createdBy.lastname }}</dd>

        <dt>Technicien assigné</dt>
        <dd>
            {% if ticket.assignedTo %}
                {{ ticket.assignedTo.firstname }} {{ ticket.assignedTo.lastname }}
            {% else %}
                Non assigné
            {% endif %}
        </dd>

        <dt>Statut</dt>
        <dd>{{ ticket.status }}</dd>

        <dt>Priorité</dt>
        <dd>{{ ticket.priority }}</dd>

        <dt>Catégorie</dt>
        <dd>{{ ticket.category ? ticket.category.name : 'Non catégorisé' }}</dd>

        <dt>Source</dt>
        <dd>{{ ticket.source }}</dd>

        <dt>Date de création</dt>
        <dd>{{ ticket.createdAt|date('d/m/Y H:i') }}</dd>
    </dl>

    {% if not ticket.assignedTo %}
        <form method="post" action="{{ path('app_technician_ticket_assign', {id: ticket.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('assign-ticket-' ~ ticket.id) }}">
            <button type="submit">M'assigner ce ticket</button>
        </form>
    {% endif %}

    {% if can_update_status %}
        <form method="post" action="{{ path('app_technician_ticket_status', {id: ticket.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('update-ticket-status-' ~ ticket.id) }}">

            <label for="ticket-status">Statut</label>
            <select id="ticket-status" name="status">
                {% for status in allowed_statuses %}
                    <option value="{{ status }}"{% if ticket.status == status %} selected{% endif %}>{{ status }}</option>
                {% endfor %}
            </select>

            <button type="submit">Modifier le statut</button>
        </form>
    {% endif %}

    {% if can_update_priority %}
        <form method="post" action="{{ path('app_technician_ticket_priority', {id: ticket.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('update-ticket-priority-' ~ ticket.id) }}">

            <label for="ticket-priority">Priorité</label>
            <select id="ticket-priority" name="priority">
                {% for priority in allowed_priorities %}
                    <option value="{{ priority }}"{% if ticket.priority == priority %} selected{% endif %}>{{ priority }}</option>
                {% endfor %}
            </select>

            <button type="submit">Modifier la priorité</button>
        </form>
    {% endif %}

    {% if can_update_category %}
        {% if categories is not empty %}
            <form method="post" action="{{ path('app_technician_ticket_category', {id: ticket.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('update-ticket-category-' ~ ticket.id) }}">

                <label for="ticket-category">Catégorie</label>
                <select id="ticket-category" name="category_id">
                    {% for category in categories %}
                        <option value="{{ category.id }}"{% if ticket.category and ticket.category.id == category.id %} selected{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                </select>

                <button type="submit">Modifier la catégorie</button>
            </form>
        {% else %}
            <p>Aucune catégorie n'est disponible.</p>
        {% endif %}
    {% endif %}

    <p>
        <a href="{{ path('app_technician_tickets') }}">Retour à la liste des tickets</a>
    </p>

{% endblock %}
