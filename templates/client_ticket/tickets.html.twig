{% extends 'base.html.twig' %}

{% block title %}Mes tickets | Pilot AI{% endblock %}

{% block body %}
    <style>
        .client-tickets {
            min-height: 100vh;
            padding: 3rem;
            background: #f8fafc;
            color: #0f172a;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .client-tickets__content {
            width: min(100%, 73.75rem);
            margin: 0 auto;
        }

        .client-tickets__header {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .client-tickets h1 {
            margin: 0;
            font-size: 1.875rem;
            line-height: 1.2;
        }

        .client-tickets__subtitle {
            margin: 0.5rem 0 0;
            color: #64748b;
            font-size: 0.9375rem;
        }

        .client-tickets__action {
            display: inline-block;
            flex: none;
            padding: 0.65rem 0.9rem;
            border: 1px solid #2563eb;
            border-radius: 0.5rem;
            background: #2563eb;
            color: #fff;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
        }

        .client-tickets__list {
            display: grid;
            gap: 1rem;
        }

        .client-ticket-card {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            justify-content: space-between;
            padding: 1.25rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            background: #fff;
        }

        .client-ticket-card__reference {
            color: #2563eb;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .client-ticket-card__title {
            display: inline-block;
            margin-top: 0.4rem;
            color: #0f172a;
            font-size: 1.0625rem;
            font-weight: 600;
            text-decoration: none;
        }

        .client-ticket-card__title:hover,
        .client-ticket-card__title:focus-visible {
            color: #2563eb;
            text-decoration: underline;
        }

        .client-ticket-card__date {
            margin: 0.4rem 0 0;
            color: #64748b;
            font-size: 0.75rem;
        }

        .client-ticket-card__status {
            flex: none;
            padding: 0.375rem 0.625rem;
            border-radius: 999px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 0.6875rem;
            font-weight: 600;
        }

        .client-ticket-card__status--in_progress {
            background: #f5f3ff;
            color: #7c3aed;
        }

        .client-ticket-card__status--resolved {
            background: #f0fdf4;
            color: #16a34a;
        }

        .client-ticket-card__status--closed {
            background: #f1f5f9;
            color: #475569;
        }

        .client-tickets__empty {
            padding: 2rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            background: #fff;
            text-align: center;
        }

        .client-tickets__empty p {
            margin: 0 0 1rem;
            color: #64748b;
        }

        @media (max-width: 48rem) {
            .client-tickets {
                padding: 1.5rem;
            }

            .client-tickets__header,
            .client-ticket-card {
                flex-direction: column;
            }

            .client-tickets__action {
                width: 100%;
                text-align: center;
            }
        }
    </style>

    <main class="client-tickets">
        <div class="client-tickets__content">
            <header class="client-tickets__header">
                <div>
                    <h1>Mes tickets</h1>
                    <p class="client-tickets__subtitle">Retrouvez toutes vos demandes de support.</p>
                </div>

                <a class="client-tickets__action" href="{{ path('app_client_ticket_new') }}">Nouvelle demande</a>
            </header>

            {% if tickets is empty %}
                <div class="client-tickets__empty">
                    <p>Vous n'avez encore aucune demande de support.</p>
                    <a class="client-tickets__action" href="{{ path('app_client_ticket_new') }}">Créer une nouvelle demande</a>
                </div>
            {% else %}
                <div class="client-tickets__list">
                    {% for ticket in tickets %}
                        <article class="client-ticket-card">
                            <div>
                                <div class="client-ticket-card__reference">#{{ ticket.id }}</div>
                                <a class="client-ticket-card__title" href="{{ path('app_client_ticket_show', {id: ticket.id}) }}">{{ ticket.title }}</a>
                                <p class="client-ticket-card__date">
                                    {% if ticket.createdAt|date('Y-m-d') == 'now'|date('Y-m-d') %}
                                        Créé aujourd’hui
                                    {% else %}
                                        {{ ticket.createdAt|date('d/m/Y') }}
                                    {% endif %}
                                </p>
                            </div>

                            <span class="client-ticket-card__status client-ticket-card__status--{{ ticket.status|lower }}">
                                {{ status_labels[ticket.status] }}
                            </span>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </main>
{% endblock %}
