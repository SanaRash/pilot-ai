<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html,
            body {
                min-width: 0;
            }

            body {
                margin: 0;
            }

            img,
            svg,
            video,
            canvas {
                max-width: 100%;
                height: auto;
            }

            a,
            button,
            input,
            select,
            textarea {
                max-width: 100%;
            }

            button,
            input,
            select,
            textarea {
                font: inherit;
            }

            [class$="__content"],
            [class$="__card"],
            [class$="__section"],
            [class$="__header"],
            [class$="__top"],
            [class$="__title"],
            [class$="__subtitle"],
            [class$="__description"],
            [class$="__meta"],
            [class$="__label"],
            [class$="__value"],
            [class*="__badge"],
            [class*="__status"] {
                min-width: 0;
                overflow-wrap: anywhere;
            }

            .role-navigation {
                border-bottom: 1px solid #e2e8f0;
                background: #fff;
                color: #0f172a;
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            .role-navigation__inner {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem;
                align-items: center;
                justify-content: space-between;
                width: min(100%, 76rem);
                margin: 0 auto;
                padding: 0.85rem 1.5rem;
            }

            .role-navigation__groups {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                align-items: center;
            }

            .role-navigation__group {
                display: flex;
                flex-wrap: wrap;
                gap: 0.4rem;
                align-items: center;
            }

            .role-navigation__label {
                color: #64748b;
                font-size: 0.75rem;
                font-weight: 800;
                text-transform: uppercase;
            }

            .role-navigation__link {
                display: inline-flex;
                align-items: center;
                min-height: 2.5rem;
                padding: 0.45rem 0.65rem;
                border-radius: 0.5rem;
                color: #334155;
                font-size: 0.875rem;
                font-weight: 700;
                overflow-wrap: anywhere;
                text-decoration: none;
            }

            .role-navigation__link:hover,
            .role-navigation__link:focus-visible {
                background: #eff6ff;
                color: #2563eb;
                outline: 2px solid transparent;
                text-decoration: underline;
            }

            .role-navigation__link[aria-current="page"] {
                background: #2563eb;
                color: #fff;
            }

            .role-navigation__logout {
                border: 1px solid #e2e8f0;
                background: #f8fafc;
            }

            .flash-messages {
                display: grid;
                gap: 0.75rem;
                width: min(100%, 76rem);
                margin: 1rem auto 0;
                padding: 0 1.5rem;
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            .flash-messages__message {
                max-width: 100%;
                padding: 0.85rem 1rem;
                border: 1px solid #bfdbfe;
                border-radius: 0.75rem;
                background: #eff6ff;
                color: #1d4ed8;
                font-size: 0.875rem;
                font-weight: 700;
            }

            .flash-messages__message--success {
                border-color: #bbf7d0;
                background: #f0fdf4;
                color: #166534;
            }

            .flash-messages__message--warning {
                border-color: #fde68a;
                background: #fffbeb;
                color: #92400e;
            }

            .flash-messages__message--error,
            .flash-messages__message--danger {
                border-color: #fecaca;
                background: #fef2f2;
                color: #991b1b;
            }

            .empty-state {
                display: grid;
                max-width: 100%;
                gap: 0.85rem;
                padding: 1.25rem;
                border: 1px solid #e2e8f0;
                border-radius: 0.875rem;
                background: #fff;
                color: #64748b;
            }

            .empty-state__message {
                margin: 0;
                line-height: 1.5;
                overflow-wrap: anywhere;
            }

            .empty-state__action {
                display: inline-flex;
                width: fit-content;
                max-width: 100%;
                align-items: center;
                padding: 0.65rem 0.9rem;
                border: 1px solid #2563eb;
                border-radius: 0.6rem;
                background: #2563eb;
                color: #fff;
                font-size: 0.875rem;
                font-weight: 700;
                text-decoration: none;
            }

            .empty-state__action:hover,
            .empty-state__action:focus-visible {
                background: #1d4ed8;
                outline: 2px solid transparent;
                text-decoration: underline;
            }

            .auth-page {
                min-height: 100vh;
                display: grid;
                place-items: center;
                padding: 3.5rem 1.5rem;
                background: #f8fafc;
                color: #0f172a;
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            .auth-card {
                width: min(100%, 28rem);
                padding: 1.75rem;
                border: 1px solid #e2e8f0;
                border-radius: 1rem;
                background: #fff;
                box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            }

            .auth-header {
                margin-bottom: 1.5rem;
            }

            .auth-title {
                margin: 0;
                color: #0f172a;
                font-size: 1.75rem;
                line-height: 1.2;
            }

            .auth-subtitle {
                margin: 0.65rem 0 0;
                color: #64748b;
                font-size: 0.9375rem;
                line-height: 1.5;
            }

            .auth-form {
                display: grid;
                gap: 1rem;
            }

            .auth-field {
                display: grid;
                gap: 0.45rem;
            }

            .auth-field label {
                color: #334155;
                font-size: 0.8125rem;
                font-weight: 700;
            }

            .auth-field input:not([type="checkbox"]) {
                width: 100%;
                padding: 0.75rem;
                border: 1px solid #e2e8f0;
                border-radius: 0.625rem;
                background: #fff;
                color: #0f172a;
                font-size: 0.9375rem;
            }

            .auth-field input:focus-visible {
                border-color: #2563eb;
                outline: 3px solid #dbeafe;
            }

            .auth-field--checkbox {
                display: flex;
                gap: 0.6rem;
                align-items: flex-start;
            }

            .auth-field--checkbox input {
                flex: none;
                margin-top: 0.2rem;
            }

            .auth-actions {
                display: grid;
                gap: 0.75rem;
                margin-top: 0.25rem;
            }

            .auth-button {
                display: inline-flex;
                min-height: 2.75rem;
                align-items: center;
                justify-content: center;
                padding: 0.75rem 1rem;
                border: 1px solid #2563eb;
                border-radius: 0.625rem;
                background: #2563eb;
                color: #fff;
                font-size: 0.9375rem;
                font-weight: 700;
                text-decoration: none;
                cursor: pointer;
            }

            .auth-button:hover,
            .auth-button:focus-visible {
                background: #1d4ed8;
                outline: 2px solid transparent;
                text-decoration: underline;
            }

            .auth-link {
                color: #2563eb;
                font-weight: 700;
            }

            .auth-error {
                margin: 0 0 1rem;
                padding: 0.85rem 1rem;
                border: 1px solid #fecaca;
                border-radius: 0.75rem;
                background: #fef2f2;
                color: #991b1b;
                font-size: 0.875rem;
                font-weight: 700;
            }

            .auth-user-notice {
                margin: 0 0 1rem;
                padding: 0.85rem 1rem;
                border: 1px solid #bfdbfe;
                border-radius: 0.75rem;
                background: #eff6ff;
                color: #1d4ed8;
                font-size: 0.875rem;
            }

            .auth-form ul {
                margin: 0.4rem 0 0;
                padding: 0;
                color: #991b1b;
                font-size: 0.8125rem;
                list-style: none;
            }

            @media (max-width: 48rem) {
                .role-navigation__inner {
                    align-items: flex-start;
                    padding: 0.85rem 1rem;
                }

                .role-navigation__groups,
                .role-navigation__group {
                    align-items: flex-start;
                    flex-direction: column;
                    width: 100%;
                }

                .role-navigation__link {
                    width: 100%;
                }

                .flash-messages {
                    padding: 0 1rem;
                }

                .auth-page {
                    padding: 1.5rem;
                    place-items: start center;
                }

                .auth-card {
                    padding: 1.25rem;
                }
            }
        </style>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.user %}
            {% include '_role_navigation.html.twig' %}
        {% endif %}

        {% include '_flash_messages.html.twig' %}

        {% block body %}{% endblock %}
    </body>
</html>
