<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html,
            body {
                min-width: 0;
            }

            :root {
                --pilot-ink: #172033;
                --pilot-muted: #6b7280;
                --pilot-bg: #f4f7fb;
                --pilot-surface: #ffffff;
                --pilot-border: #e6eaf0;
                --pilot-primary: #5b5bd6;
                --pilot-primary-dark: #4747b8;
                --pilot-primary-soft: #eeeeff;
                --pilot-accent: #20b8a6;
                --pilot-shadow: 0 16px 40px rgba(23, 32, 51, 0.08);
            }

            body {
                margin: 0;
                background: var(--pilot-bg);
                color: var(--pilot-ink);
                font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            img,
            svg,
            video,
            canvas {
                max-width: 100%;
                height: auto;
            }

            a,
            button,
            input,
            select,
            textarea {
                max-width: 100%;
            }

            button,
            input,
            select,
            textarea {
                font: inherit;
            }

            [class$="__content"],
            [class$="__card"],
            [class$="__section"],
            [class$="__header"],
            [class$="__top"],
            [class$="__title"],
            [class$="__subtitle"],
            [class$="__description"],
            [class$="__meta"],
            [class$="__label"],
            [class$="__value"],
            [class*="__badge"],
            [class*="__status"] {
                min-width: 0;
                overflow-wrap: anywhere;
            }

            .role-navigation {
                position: sticky;
                top: 0;
                z-index: 50;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                background: rgba(23, 32, 51, 0.96);
                color: #fff;
                backdrop-filter: blur(14px);
                box-shadow: 0 8px 28px rgba(23, 32, 51, 0.12);
            }

            .role-navigation__inner {
                display: flex;
                gap: 1.25rem;
                align-items: center;
                justify-content: space-between;
                width: min(100%, 80rem);
                margin: 0 auto;
                padding: 0.8rem 1.5rem;
            }

            .role-navigation__brand {
                display: inline-flex;
                flex: none;
                gap: 0.7rem;
                align-items: center;
                color: #fff;
                font-size: 1rem;
                font-weight: 850;
                letter-spacing: -0.02em;
                text-decoration: none;
            }

            .role-navigation__brand-mark {
                display: grid;
                width: 2.2rem;
                height: 2.2rem;
                place-items: center;
                border-radius: 0.7rem;
                background: linear-gradient(135deg, #7777f0, #20b8a6);
                box-shadow: 0 8px 20px rgba(91, 91, 214, 0.35);
                font-size: 0.78rem;
                font-weight: 900;
            }

            .role-navigation__groups {
                display: flex;
                flex: 1;
                flex-wrap: wrap;
                gap: 0.65rem;
                align-items: center;
                justify-content: center;
            }

            .role-navigation__group {
                display: flex;
                flex-wrap: wrap;
                gap: 0.25rem;
                align-items: center;
            }

            .role-navigation__label {
                margin-right: 0.35rem;
                color: #9ca7bb;
                font-size: 0.68rem;
                font-weight: 800;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            .role-navigation__link {
                display: inline-flex;
                align-items: center;
                min-height: 2.35rem;
                padding: 0.45rem 0.75rem;
                border-radius: 0.65rem;
                color: #d9deea;
                font-size: 0.84rem;
                font-weight: 700;
                text-decoration: none;
                transition: background 160ms ease, color 160ms ease, transform 160ms ease;
            }

            .role-navigation__link:hover,
            .role-navigation__link:focus-visible {
                background: rgba(255, 255, 255, 0.09);
                color: #fff;
                outline: none;
                text-decoration: none;
                transform: translateY(-1px);
            }

            .role-navigation__link[aria-current="page"] {
                background: rgba(119, 119, 240, 0.2);
                color: #fff;
                box-shadow: inset 0 0 0 1px rgba(152, 152, 255, 0.28);
            }

            .role-navigation__account {
                display: flex;
                flex: none;
                gap: 0.55rem;
                align-items: center;
            }

            .role-navigation__user {
                max-width: 13rem;
                overflow: hidden;
                color: #c9d0df;
                font-size: 0.78rem;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .role-navigation__logout {
                border: 1px solid rgba(255, 255, 255, 0.12);
                background: rgba(255, 255, 255, 0.06);
                color: #fff;
            }

            .flash-messages {
                display: grid;
                gap: 0.75rem;
                width: min(100%, 76rem);
                margin: 1rem auto 0;
                padding: 0 1.5rem;
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            .flash-messages__message {
                max-width: 100%;
                padding: 0.85rem 1rem;
                border: 1px solid #bfdbfe;
                border-radius: 0.75rem;
                background: #eff6ff;
                color: #1d4ed8;
                font-size: 0.875rem;
                font-weight: 700;
            }

            .flash-messages__message--success {
                border-color: #bbf7d0;
                background: #f0fdf4;
                color: #166534;
            }

            .flash-messages__message--warning {
                border-color: #fde68a;
                background: #fffbeb;
                color: #92400e;
            }

            .flash-messages__message--error,
            .flash-messages__message--danger {
                border-color: #fecaca;
                background: #fef2f2;
                color: #991b1b;
            }

            .empty-state {
                display: grid;
                max-width: 100%;
                gap: 0.85rem;
                padding: 1.25rem;
                border: 1px solid #e2e8f0;
                border-radius: 0.875rem;
                background: #fff;
                color: #64748b;
            }

            .empty-state__message {
                margin: 0;
                line-height: 1.5;
                overflow-wrap: anywhere;
            }

            .empty-state__action {
                display: inline-flex;
                width: fit-content;
                max-width: 100%;
                align-items: center;
                padding: 0.65rem 0.9rem;
                border: 1px solid #2563eb;
                border-radius: 0.6rem;
                background: #2563eb;
                color: #fff;
                font-size: 0.875rem;
                font-weight: 700;
                text-decoration: none;
            }

            .empty-state__action:hover,
            .empty-state__action:focus-visible {
                background: var(--pilot-primary-dark);
                outline: 2px solid transparent;
                text-decoration: underline;
            }

            .auth-page {
                min-height: 100vh;
                display: grid;
                place-items: center;
                padding: 3.5rem 1.5rem;
                background: radial-gradient(circle at top left, #eeeeff 0, transparent 34%), radial-gradient(circle at bottom right, #dcfaf5 0, transparent 30%), #f6f8fc;
                color: var(--pilot-ink);
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            .auth-card {
                width: min(100%, 29rem);
                padding: 2rem;
                border: 1px solid rgba(230, 234, 240, 0.9);
                border-radius: 1.35rem;
                background: rgba(255, 255, 255, 0.94);
                box-shadow: var(--pilot-shadow);
            }

            .auth-header {
                margin-bottom: 1.5rem;
            }

            .auth-title {
                margin: 0;
                color: var(--pilot-ink);
                font-size: 2rem;
                line-height: 1.2;
            }

            .auth-subtitle {
                margin: 0.65rem 0 0;
                color: #64748b;
                font-size: 0.9375rem;
                line-height: 1.5;
            }

            .auth-form {
                display: grid;
                gap: 1rem;
            }

            .auth-field {
                display: grid;
                gap: 0.45rem;
            }

            .auth-field label {
                color: #334155;
                font-size: 0.8125rem;
                font-weight: 700;
            }

            .auth-field input:not([type="checkbox"]) {
                width: 100%;
                padding: 0.75rem;
                border: 1px solid #e2e8f0;
                border-radius: 0.625rem;
                background: #fff;
                color: #0f172a;
                font-size: 0.9375rem;
            }

            .auth-field input:focus-visible {
                border-color: var(--pilot-primary);
                outline: 3px solid var(--pilot-primary-soft);
            }

            .auth-field--checkbox {
                display: flex;
                gap: 0.6rem;
                align-items: flex-start;
            }

            .auth-field--checkbox input {
                flex: none;
                margin-top: 0.2rem;
            }

            .auth-actions {
                display: grid;
                gap: 0.75rem;
                margin-top: 0.25rem;
            }

            .auth-button {
                display: inline-flex;
                min-height: 2.75rem;
                align-items: center;
                justify-content: center;
                padding: 0.75rem 1rem;
                border: 1px solid var(--pilot-primary);
                border-radius: 0.75rem;
                background: linear-gradient(135deg, var(--pilot-primary), #6f6fe5);
                color: #fff;
                font-size: 0.9375rem;
                font-weight: 700;
                text-decoration: none;
                cursor: pointer;
            }

            .auth-button:hover,
            .auth-button:focus-visible {
                background: var(--pilot-primary-dark);
                outline: 2px solid transparent;
                text-decoration: underline;
            }

            .auth-link {
                color: var(--pilot-primary);
                font-weight: 700;
            }

            .auth-error {
                margin: 0 0 1rem;
                padding: 0.85rem 1rem;
                border: 1px solid #fecaca;
                border-radius: 0.75rem;
                background: #fef2f2;
                color: #991b1b;
                font-size: 0.875rem;
                font-weight: 700;
            }

            .auth-user-notice {
                margin: 0 0 1rem;
                padding: 0.85rem 1rem;
                border: 1px solid #bfdbfe;
                border-radius: 0.75rem;
                background: #eff6ff;
                color: #1d4ed8;
                font-size: 0.875rem;
            }

            .auth-form ul {
                margin: 0.4rem 0 0;
                padding: 0;
                color: #991b1b;
                font-size: 0.8125rem;
                list-style: none;
            }

            @media (max-width: 48rem) {
                .role-navigation__inner {
                    align-items: flex-start;
                    padding: 0.85rem 1rem;
                }

                .role-navigation__inner {
                    flex-wrap: wrap;
                }

                .role-navigation__groups {
                    order: 3;
                    width: 100%;
                    justify-content: flex-start;
                }

                .role-navigation__group {
                    width: 100%;
                }

                .role-navigation__label {
                    width: 100%;
                    margin: 0.2rem 0;
                }

                .role-navigation__user {
                    display: none;
                }

                .flash-messages {
                    padding: 0 1rem;
                }

                .auth-page {
                    padding: 1.5rem;
                    place-items: start center;
                }

                .auth-card {
                    padding: 1.25rem;
                }
            }
        </style>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.user %}
            {% include '_role_navigation.html.twig' %}
        {% endif %}

        {% include '_flash_messages.html.twig' %}

        {% block body %}{% endblock %}
    </body>
</html>
