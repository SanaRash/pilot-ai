{% extends 'base.html.twig' %}

{% block title %}Connexion | Pilot AI{% endblock %}

{% block body %}
    <main class="auth-page">
        <section class="auth-card" aria-labelledby="login-title">
            <div class="auth-brand" aria-label="Pilot AI">
                <span class="auth-brand__mark">AI</span>
                <span>Pilot AI</span>
            </div>

            <header class="auth-header">
                <h1 id="login-title" class="auth-title">Connexion</h1>
                <p class="auth-subtitle">Accédez à votre espace Pilot AI.</p>
            </header>

            {% if error %}
                <div class="auth-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="auth-user-notice">
                    Vous êtes connecté avec {{ app.user.userIdentifier }},
                    <a class="auth-link" href="{{ logout_path() }}">se déconnecter</a>.
                </div>
            {% endif %}

            <form class="auth-form" method="post">
                <div class="auth-field">
                    <label for="username">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>
                </div>

                <div class="auth-field">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="auth-field auth-field--checkbox">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Se souvenir de moi</label>
                    </div>
                #}

                <div class="auth-actions">
                    <button class="auth-button" type="submit">Se connecter</button>
                </div>
            </form>
        </section>
    </main>
{% endblock %}
