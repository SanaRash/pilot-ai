{% extends 'base.html.twig' %}

{% block title %}Mon espace | Pilot AI{% endblock %}

{% block body %}
    <style>
        .client-dashboard {
            min-height: 100vh;
            padding: 3.5rem;
            background: #f8fafc;
            color: #0f172a;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .client-dashboard__content {
            width: min(100%, 73.75rem);
            margin: 0 auto;
        }

        .client-dashboard h1 {
            margin: 0;
            font-size: 1.875rem;
            line-height: 1.2;
        }

        .client-dashboard__subtitle {
            margin: 0.75rem 0 0;
            color: #64748b;
            font-size: 0.9375rem;
        }

        .client-dashboard__section-header {
            display: flex;
            gap: 1rem;
            align-items: center;
            justify-content: space-between;
            margin: 2rem 0 1rem;
        }

        .client-dashboard__section-header h2 {
            margin: 0;
            font-size: 1.25rem;
        }

        .client-dashboard__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .client-dashboard__action {
            display: inline-block;
            padding: 0.65rem 0.9rem;
            border: 1px solid #cbd5e1;
            border-radius: 0.6rem;
            background: #fff;
            color: #0f172a;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
        }

        .client-dashboard__action--primary {
            border-color: #2563eb;
            background: #2563eb;
            color: #fff;
        }

        .client-dashboard__tickets {
            display: grid;
            gap: 1rem;
        }

        .dashboard-ticket {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            justify-content: space-between;
            padding: 1.25rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.875rem;
            background: #fff;
        }

        .dashboard-ticket__reference {
            color: #2563eb;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .dashboard-ticket__title {
            display: inline-block;
            margin-top: 0.4rem;
            color: #0f172a;
            font-size: 1.0625rem;
            font-weight: 600;
            text-decoration: none;
        }

        .dashboard-ticket__title:hover,
        .dashboard-ticket__title:focus-visible {
            color: #2563eb;
            text-decoration: underline;
        }

        .dashboard-ticket__date {
            margin: 0.4rem 0 0;
            color: #64748b;
            font-size: 0.75rem;
        }

        .dashboard-ticket__status {
            flex: none;
            padding: 0.375rem 0.625rem;
            border-radius: 999px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 0.6875rem;
            font-weight: 600;
        }

        .dashboard-ticket__status--in_progress {
            background: #f5f3ff;
            color: #7c3aed;
        }

        .dashboard-ticket__status--resolved {
            background: #f0fdf4;
            color: #16a34a;
        }

        .dashboard-ticket__status--closed {
            background: #f1f5f9;
            color: #475569;
        }

        .client-dashboard__empty {
            padding: 2rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.875rem;
            background: #fff;
            text-align: center;
        }

        .client-dashboard__empty p {
            margin: 0 0 1rem;
            color: #64748b;
        }

        @media (max-width: 48rem) {
            .client-dashboard {
                padding: 1.5rem;
            }

            .client-dashboard__section-header,
            .dashboard-ticket {
                align-items: stretch;
                flex-direction: column;
            }

            .client-dashboard__action {
                width: 100%;
                text-align: center;
            }
        }

    </style>

    <main class="client-dashboard">
        <div class="client-dashboard__content">
            <h1>Bonjour {{ client.firstname }} 👋</h1>
            <p class="client-dashboard__subtitle">Suivez vos demandes de support.</p>

            <section aria-labelledby="recent-requests-title">
                <div class="client-dashboard__section-header">
                    <h2 id="recent-requests-title">Demandes récentes</h2>

                    <nav class="client-dashboard__actions" aria-label="Actions sur les demandes">
                        <a class="client-dashboard__action" href="{{ path('app_client_tickets') }}">Voir tous mes tickets</a>
                        <a class="client-dashboard__action client-dashboard__action--primary" href="{{ path('app_client_ticket_new') }}">Nouvelle demande</a>
                    </nav>
                </div>

                {% if recent_tickets is empty %}
                    {% include '_empty_state.html.twig' with {
                        message: "Vous n'avez encore aucune demande de support.",
                        action_label: 'Créer une nouvelle demande',
                        action_path: path('app_client_ticket_new')
                    } only %}
                {% else %}
                    <div class="client-dashboard__tickets">
                        {% for ticket in recent_tickets %}
                            <article class="dashboard-ticket">
                                <div>
                                    <div class="dashboard-ticket__reference">#{{ ticket.id }}</div>
                                    <a class="dashboard-ticket__title" href="{{ path('app_client_ticket_show', {id: ticket.id}) }}">{{ ticket.title }}</a>
                                    <p class="dashboard-ticket__date">
                                        {% if ticket.createdAt|date('Y-m-d') == 'now'|date('Y-m-d') %}
                                            Créé aujourd’hui
                                        {% else %}
                                            {{ ticket.createdAt|date('d/m/Y') }}
                                        {% endif %}
                                    </p>
                                </div>

                                <span class="dashboard-ticket__status dashboard-ticket__status--{{ ticket.status|lower }}">
                                    {{ status_labels[ticket.status] }}
                                </span>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>
    </main>
{% endblock %}
