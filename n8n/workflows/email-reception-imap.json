        "assignments": {
          "assignments": [
            {
              "id": "sender-normalized",
              "name": "sender",
              "type": "string",
              "value": "={{ (() => { const source = $json.from; const fallback = $json.metadata?.from; const raw = String((typeof source === 'string' && source.trim() !== '' ? source : fallback) ?? '').trim(); const isEmail = (value) => /^[^\\s@<>]+@[^\\s@<>]+$/.test(value); const candidates = /<([^<>]+)>|([^\\s<>,;]+@[^\\s<>,;]+)/g; let match; while ((match = candidates.exec(raw)) !== null) { const candidate = (match[1] ?? match[2]).trim(); if (isEmail(candidate)) return candidate; } return null; })() }}"
            }
          ]
        },
        "options": {
          "dotNotation": true
        }
      },
